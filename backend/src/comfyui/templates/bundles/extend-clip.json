  "template": {
    "key": "extend-clip",
    "version": 1,
    "confidence": "unverified",
    "summary": "Five more seconds, generated from the last frame of the clip you already have.",
    "notes": "The same Wan 2.1 I2V graph as 'Photo to 5s clip', driven from the clip's final frame. Phos extracts that frame (source_mode last_frame) and the contract is corrected to say the stage eats video, so it can follow a video stage in a line. Chain it after itself to keep going."
  },
  "line": {
    "name": "Extend clip +5s",
    "description": "One stage: a clip in, five more seconds continued from its last frame.",
    "stages": [
      {
        "workflow": "wan-extend",
        "keep_output": true,
        "source_mode": "last_frame"
      }
    ]
  },
